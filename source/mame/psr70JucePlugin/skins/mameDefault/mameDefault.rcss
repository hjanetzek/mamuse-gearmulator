/* the PSR-70 layout is 1314 x 480 at its natural size */

/* fixed window mode: the window can't be resized, its size follows the UI scale (the plugin menu's, or uiscale in
   mame-plugin.ini) */
body
{
	left: 0dp;
	top: 0dp;
	width: 1314dp;
	height: 480dp;
	background-color: #1c1c1c;
}

#panel
{
	position: absolute;
	left: 0dp;
	top: 0dp;
	width: 100%;
	height: 100%;
}
